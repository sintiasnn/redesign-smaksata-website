---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const berita = (await getCollection('berita'))
  .map(e => ({ ...e.data, description: e.body?.slice(0, 150) }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

const acara = (await getCollection('acara'))
  .map(e => e.data)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

const programData = (await getCollection('programs'))
  .map(e => e.data)

const colorClasses = { primary: 'text-primary-600 hover:text-primary-700', secondary: 'text-secondary-600 hover:text-secondary-700', accent: 'text-accent-600 hover:text-accent-700' }

const getProgramImage = (id: string) => {
  const map = { akl: 'akuntansi', bdp: 'bisnis-digital', otkp: 'manajemen-perkantoran', tkj: 'tkj' }
  return `${base}assets/images/program-${map[id as keyof typeof map]}.svg`
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const fasilitas = [
  { title: 'Laboratorium Komputer', desc: 'Dilengkapi komputer terbaru dan koneksi internet cepat' },
  { title: 'Laboratorium Akuntansi', desc: 'Fasilitas praktik untuk program keahlian Akuntansi' },
  { title: 'Business Center', desc: 'Tempat praktik kewirausahaan dan pemasaran' },
  { title: 'Perpustakaan Digital', desc: 'Koleksi buku dan sumber belajar digital' },
  { title: 'Aula Serbaguna', desc: 'Ruang pertemuan dan kegiatan dengan kapasitas besar' },
  { title: 'Lapangan Olahraga', desc: 'Fasilitas olahraga lengkap untuk kegiatan siswa' },
]

const prestasi = [
  { title: 'Juara LKS Tingkat Nasional', desc: 'Juara 1 Lomba Kompetensi Siswa bidang Akuntansi tingkat Nasional 2023' },
  { title: 'Sekolah Adiwiyata', desc: 'Penghargaan Sekolah Adiwiyata tingkat Nasional tahun 2022' },
  { title: 'Juara Debat Bahasa Inggris', desc: 'Juara 1 Lomba Debat Bahasa Inggris tingkat Provinsi 2023' },
]

const galleryImages = Array.from({ length: 13 }, (_, i) => `${base}assets/images/galeri-${String(i + 1).padStart(2, '0')}.jpg`)

const sejarahMilestones = [
  { tahun: '1962', text: 'Pemerintah Kabupaten Tabanan menggagas berdirinya SMEA Tabanan untuk menampung lulusan SMEP. Berlokasi di gedung SD sekitar Pasar Tabanan dengan bangunan bambu (bangsal) sebagai tempat belajar.' },
  { tahun: '1964', text: 'Surat Keputusan Pemerintah tentang berdirinya SMEA Negeri Tabanan, dengan Kepala Sekolah pertama I Dewa Gede Rai Konta. Mengasuh dua jurusan: Tata Buku (cikal bakal Akuntansi) dan Tata Niaga (cikal bakal Pemasaran).' },
  { tahun: '1967', text: 'SMEA Negeri Tabanan dipindahkan ke lokasi sekarang (Jl. Diponegoro). Siswa dan guru bergotong royong membangun gedung dari bahan-bahan sederhana. Semangat belajar tetap tinggi meskipun dengan fasilitas seadanya.' },
  { tahun: '1968—1989', text: 'Dipimpin I Nyoman Retu Giri, sekolah meraih segudang prestasi akademis maupun non akademis. Mengasuh tiga jurusan: Tata Buku, Tata Niaga dan Tata Usaha (cikal bakal Administrasi Perkantoran).' },
  { tahun: '18 Mar 1997', text: 'Perubahan nama dari SMEA Negeri Tabanan menjadi SMK Negeri 1 Tabanan melalui surat Edaran Direktorat Pendidikan Menengah Kejuruan. Bidang Keahlian: Bisnis dan Manajemen dengan tiga program: Akuntansi, Penjualan dan Sekretaris.' },
  { tahun: '2005', text: 'Ditetapkan sebagai SMK Berstandar Nasional (SSN) pada tahun 2005, dan kemudian sebagai SMK Berstandar Internasional (SBI) pada 18 Agustus 2009.' },
  { tahun: 'Sekarang', text: 'Mengasuh 4 konsentrasi keahlian: Akuntansi dan Keuangan Lembaga (AKL), Bisnis Daring dan Pemasaran (BDP), Otomatisasi dan Tata Kelola Perkantoran (OTKP), serta Teknik Komputer dan Jaringan (TKJ). Terus berkembang mencetak lulusan yang kompeten, kompetitif, dan siap kerja.' },
]

const formatDate = (d: string) => {
  try { return new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) } catch { return d }
}
const formatDateShort = (d: string) => {
  try { return new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) } catch { return d }
}
---

<Layout>
  <!-- Hero Section -->
  <section id="beranda" class="hero-section p-0">
    <div class="swiper hero-slider h-screen">
      <div class="swiper-wrapper">
        <div class="swiper-slide relative">
          <div class="absolute inset-0 bg-black/50"></div>
          <img src={base + 'assets/images/hero-kegiatan-lab.jpg'} alt="SMK Negeri 1 Tabanan" class="w-full h-full object-cover">
          <div class="container absolute inset-0 flex items-center">
            <div class="hero-content" data-aos="fade-up">
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Selamat Datang di<br>SMK Negeri 1 Tabanan</h1>
              <p class="text-lg md:text-xl mb-8">Membentuk generasi unggul yang terampil, profesional, dan berkarakter</p>
              <div class="flex flex-wrap gap-4">
                <a href="#program" class="btn btn-accent">Program Keahlian</a>
                <a href="https://bali.spmb.id" class="btn btn-outline-white" target="_blank">PPDB Online</a>
              </div>
            </div>
          </div>
        </div>
        <div class="swiper-slide relative">
          <div class="absolute inset-0 bg-black/50"></div>
          <img src={base + 'assets/images/hero-kegiatan-siswa.jpg'} alt="Fasilitas Sekolah" class="w-full h-full object-cover">
          <div class="container absolute inset-0 flex items-center">
            <div class="hero-content" data-aos="fade-up">
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Fasilitas Modern<br>Pembelajaran Optimal</h1>
              <p class="text-lg md:text-xl mb-8">Didukung fasilitas lengkap dan teknologi terkini untuk pembelajaran yang efektif</p>
              <a href="#fasilitas" class="btn btn-accent">Lihat Fasilitas</a>
            </div>
          </div>
        </div>
        <div class="swiper-slide relative">
          <div class="absolute inset-0 bg-black/50"></div>
          <img src={base + 'assets/images/hero-upacara.jpg'} alt="Prestasi Siswa" class="w-full h-full object-cover">
          <div class="container absolute inset-0 flex items-center">
            <div class="hero-content" data-aos="fade-up">
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Prestasi Membanggakan<br>Lulusan Berkualitas</h1>
              <p class="text-lg md:text-xl mb-8">Raih berbagai prestasi di tingkat kabupaten, provinsi, dan nasional</p>
              <a href="#prestasi" class="btn btn-accent">Lihat Prestasi</a>
            </div>
          </div>
        </div>
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </section>

  <!-- Profil -->
  <section id="profil" class="bg-white py-16 md:py-24">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Profil SMK Negeri 1 Tabanan</h2>
        <p class="text-lg text-neutral-600">Sekolah kejuruan unggulan yang telah berdiri sejak tahun 1962 dan terakreditasi A</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <img src={base + 'assets/images/profil-gedung.jpg'} alt="Gedung SMK Negeri 1 Tabanan" class="rounded-xl shadow-lg">
        </div>
        <div data-aos="fade-left">
          <h3 class="text-2xl font-bold mb-6">Visi</h3>
          <p class="text-neutral-600 mb-8">"Menjadi SMK yang unggul dalam menghasilkan lulusan yang terampil, profesional, berkarakter, dan berwawasan lingkungan"</p>
          <h3 class="text-2xl font-bold mb-6">Misi</h3>
          <ul class="space-y-4 text-neutral-600">
            <li class="flex items-start"><span class="text-accent-500 mr-2">•</span>Menyelenggarakan pendidikan kejuruan yang berkualitas</li>
            <li class="flex items-start"><span class="text-accent-500 mr-2">•</span>Mengembangkan keterampilan dan kompetensi sesuai kebutuhan industri</li>
            <li class="flex items-start"><span class="text-accent-500 mr-2">•</span>Membentuk karakter peserta didik yang berakhlak mulia</li>
            <li class="flex items-start"><span class="text-accent-500 mr-2">•</span>Menerapkan budaya lingkungan yang bersih dan sehat</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Sejarah -->
  <section id="sejarah" class="py-16 md:py-24 bg-neutral-50">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Sejarah SMK Negeri 1 Tabanan</h2>
        <p class="text-lg text-neutral-600">Perjalanan panjang dalam mencetak generasi unggul sejak 1962</p>
      </div>
      <div class="relative max-w-4xl mx-auto">
        <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-primary-200 hidden md:block"></div>
        {sejarahMilestones.map((m, i) => (
          <div class={`relative flex items-start mb-12 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`} data-aos={i % 2 === 0 ? 'fade-right' : 'fade-left'}>
            <div class="hidden md:flex w-1/2"></div>
            <div class="hidden md:flex absolute left-1/2 transform -translate-x-1/2 z-10 w-6 h-6 rounded-full bg-primary-600 border-4 border-white shadow"></div>
            <div class="w-full md:w-1/2 bg-white p-6 rounded-xl shadow-md">
              <span class="text-primary-600 font-bold text-xl">{m.tahun}</span>
              <p class="text-neutral-600 mt-2">{m.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Program -->
  <section id="program" class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Program Keahlian</h2>
        <p class="text-lg text-neutral-600">Empat program keahlian unggulan yang siap membentuk masa depanmu</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {programData.map((p, i) => (
          <div class="program-card" data-aos="fade-up" data-aos-delay={(i + 1) * 100}>
            <img src={getProgramImage(p.id)} alt={p.nama} class="w-full h-48 object-cover">
            <div class="p-6">
              <div class="program-icon mb-4"></div>
              <h3 class="text-xl font-bold mb-3">{p.nama}</h3>
              <p class="text-neutral-600 mb-4">{p.deskripsi}</p>
              <a href={base + 'detail/' + p.id} class={`${colorClasses[p.warna]} font-medium`}>Pelajari lebih lanjut →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fasilitas -->
  <section id="fasilitas" class="py-16 md:py-24 bg-neutral-50">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Fasilitas Sekolah</h2>
        <p class="text-lg text-neutral-600">Didukung fasilitas modern untuk mendukung proses belajar mengajar yang optimal</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {fasilitas.map((f, i) => (
          <div class="facility-card" data-aos="fade-up" data-aos-delay={(i % 3) * 100}>
            <div class="facility-icon mb-4"></div>
            <h3 class="text-xl font-bold mb-3">{f.title}</h3>
            <p class="text-neutral-600">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Prestasi -->
  <section id="prestasi" class="py-16 md:py-24 bg-primary-900 text-white">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Prestasi Kami</h2>
        <p class="text-lg text-neutral-300">Berbagai prestasi membanggakan yang telah diraih di berbagai bidang</p>
      </div>
      <div class="swiper achievement-slider pb-12">
        <div class="swiper-wrapper">
          {prestasi.map(p => (
            <div class="swiper-slide">
              <div class="achievement-card text-center max-w-md mx-auto">
                <div class="achievement-icon mx-auto mb-4"></div>
                <h3 class="text-2xl font-bold mb-3">{p.title}</h3>
                <p class="text-neutral-300">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </section>

  <!-- Berita -->
  <section id="berita" class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Berita Terkini</h2>
        <p class="text-lg text-neutral-600">Informasi dan kegiatan terbaru di SMK Negeri 1 Tabanan</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {berita.slice(0, 3).map((b, i) => (
          <div class="news-card" data-aos="fade-up" data-aos-delay={(i + 1) * 100}>
            <div class="relative overflow-hidden">
              <img src={base + (b.image || 'assets/images/berita-ppdb.svg')} alt={b.title} class="w-full h-48 object-cover news-image">
            </div>
            <div class="p-6">
              <div class="text-sm text-neutral-500 mb-2">{formatDate(b.date)}</div>
              <h3 class="text-xl font-bold mb-3">{b.title}</h3>
              <p class="text-neutral-600 mb-4">{b.description}</p>
              <a href="#" class="text-primary-600 font-medium hover:text-primary-700">Baca selengkapnya →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Galeri -->
  <section id="galeri" class="py-16 md:py-24 bg-neutral-50">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Galeri</h2>
        <p class="text-lg text-neutral-600">Dokumentasi kegiatan dan momen berharga di SMK Negeri 1 Tabanan</p>
      </div>
      <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {galleryImages.map((src, i) => (
          <div class="relative group cursor-pointer overflow-hidden rounded-xl" onclick={`openLightbox(${i})`} data-aos="zoom-in" data-aos-delay={(i % 4) * 100}>
            <img src={src} alt="Dokumentasi Sekolah" class="w-full h-48 md:h-56 object-cover transition-transform duration-500 group-hover:scale-110">
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <span class="text-white text-sm font-medium">Dokumentasi Sekolah</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center" onclick="closeLightbox(event)">
    <button id="close-lightbox" class="absolute top-4 right-4 text-white text-4xl z-10 hover:text-neutral-300">&times;</button>
    <button id="prev-btn" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl z-10 hover:text-neutral-300">&lsaquo;</button>
    <button id="next-btn" class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-4xl z-10 hover:text-neutral-300">&rsaquo;</button>
    <img id="lightbox-img" class="max-h-[85vh] max-w-[90vw] object-contain rounded-lg" src="" alt="">
    <p id="lightbox-caption" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-lg font-medium"></p>
  </div>

  <!-- Acara -->
  <section id="acara" class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Acara & Kegiatan</h2>
        <p class="text-lg text-neutral-600">Berbagai kegiatan dan acara yang telah dilaksanakan</p>
      </div>
      <div id="events-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {acara.slice(0, 6).map((e, i) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300" data-aos="fade-up" data-aos-delay={(i % 3) * 100}>
            <div class="relative">
              <img src={base + (e.image || 'assets/images/acara-p5.svg')} alt={e.title} class="w-full h-44 object-cover">
              <div class="absolute top-3 left-3 bg-primary-600 text-white text-xs font-bold px-3 py-1 rounded-full">{formatDateShort(e.date)}</div>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold mb-2">{e.title}</h3>
              <p class="text-neutral-600 text-sm">{e.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kontak -->
  <section id="kontak" class="py-16 md:py-24 bg-neutral-50">
    <div class="container">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Hubungi Kami</h2>
        <p class="text-lg text-neutral-600">Silakan hubungi kami untuk informasi lebih lanjut</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="contact-form bg-white p-8 rounded-xl shadow-md" data-aos="fade-right">
          <h3 class="text-2xl font-bold mb-6">Kirim Pesan</h3>
          <form id="contact-form">
            <div class="form-group mb-4">
              <label for="name">Nama Lengkap</label>
              <input type="text" id="name" class="form-input" placeholder="Masukkan nama Anda" required>
            </div>
            <div class="form-group mb-4">
              <label for="email">Email</label>
              <input type="email" id="email" class="form-input" placeholder="Masukkan email Anda" required>
            </div>
            <div class="form-group mb-4">
              <label for="subject">Subjek</label>
              <input type="text" id="subject" class="form-input" placeholder="Masukkan subjek pesan">
            </div>
            <div class="form-group mb-6">
              <label for="message">Pesan</label>
              <textarea id="message" rows="5" class="form-input" placeholder="Masukkan pesan Anda" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-full">Kirim Pesan</button>
          </form>
        </div>
        <div data-aos="fade-left">
          <div class="bg-white p-8 rounded-xl shadow-md mb-8">
            <h3 class="text-2xl font-bold mb-6">Informasi Kontak</h3>
            <div class="space-y-6">
              <div class="flex items-start"><div><p class="font-medium">Alamat</p><p class="text-neutral-600">Jl. Diponegoro No.9, Delod Peken, Kec. Tabanan, Kabupaten Tabanan, Bali 82121</p></div></div>
              <div class="flex items-start"><div><p class="font-medium">Telepon</p><p class="text-neutral-600">(0361) 811012</p></div></div>
              <div class="flex items-start"><div><p class="font-medium">Email</p><p class="text-neutral-600">info@smkn1tabanan.sch.id</p></div></div>
              <div class="flex items-start"><div><p class="font-medium">Jam Operasional</p><p class="text-neutral-600">Senin - Jumat, 07:30 - 15:30 WITA</p></div></div>
            </div>

          </div>
          <div class="map-container">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3945.7123841325473!2d115.11931661478386!3d-8.538029993857748!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd23b5c0a7b3bcd%3A0x4030bfbca7d0c70!2sSMK%20Negeri%201%20Tabanan!5e0!3m2!1sen!2sid!4v1645523452678!5m2!1sen!2sid" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  new Swiper('.hero-slider', { loop: true, autoplay: { delay: 5000 }, pagination: { el: '.swiper-pagination', clickable: true }, navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }, effect: 'fade', fadeEffect: { crossFade: true } })
  new Swiper('.achievement-slider', { loop: true, autoplay: { delay: 4000 }, pagination: { el: '.swiper-pagination', clickable: true }, breakpoints: { 640: { slidesPerView: 1 }, 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } } })

  let currentIndex = 0
  const galleryImgs = document.querySelectorAll('#gallery-grid > div')
  const lightbox = document.getElementById('lightbox')
  const lightboxImg = document.getElementById('lightbox-img')
  const lightboxCaption = document.getElementById('lightbox-caption')

  window.openLightbox = (i) => { currentIndex = i; update(i); lightbox?.classList.remove('hidden'); lightbox?.classList.add('flex'); document.body.style.overflow = 'hidden' }
  window.closeLightbox = (e) => { if (e?.target === e?.currentTarget) { lightbox?.classList.add('hidden'); lightbox?.classList.remove('flex'); document.body.style.overflow = '' } }
  function update(i) { const el = galleryImgs[i]; if (!el) return; const s = el.querySelector('img')?.src; const c = el.querySelector('span')?.textContent; if (lightboxImg) lightboxImg.src = s || ''; if (lightboxCaption) lightboxCaption.textContent = c || '' }
  document.getElementById('close-lightbox')?.addEventListener('click', () => { lightbox?.classList.add('hidden'); lightbox?.classList.remove('flex'); document.body.style.overflow = '' })
  document.getElementById('prev-btn')?.addEventListener('click', (e) => { e.stopPropagation(); currentIndex = (currentIndex - 1 + galleryImgs.length) % galleryImgs.length; update(currentIndex) })
  document.getElementById('next-btn')?.addEventListener('click', (e) => { e.stopPropagation(); currentIndex = (currentIndex + 1) % galleryImgs.length; update(currentIndex) })
  document.addEventListener('keydown', (e) => { if (!lightbox?.classList.contains('hidden')) { if (e.key === 'Escape') { lightbox.classList.add('hidden'); lightbox.classList.remove('flex'); document.body.style.overflow = '' } if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + galleryImgs.length) % galleryImgs.length; update(currentIndex) } if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % galleryImgs.length; update(currentIndex) } } })

  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault(); const name = document.getElementById('name'), email = document.getElementById('email'), msg = document.getElementById('message')
    if (!name?.value || !email?.value || !msg?.value) { alert('Harap isi semua field yang wajib'); return }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) { alert('Masukkan alamat email yang valid'); return }
    const btn = e.target.querySelector('button[type="submit"]'); btn.textContent = 'Mengirim...'; btn.disabled = true
    setTimeout(() => { alert('Pesan berhasil dikirim! Kami akan menghubungi Anda segera.'); e.target.reset(); btn.textContent = 'Kirim Pesan'; btn.disabled = false }, 1500)
  })
</script>
