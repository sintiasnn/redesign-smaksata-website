---
import '../css/main.css'
import { getCollection } from 'astro:content'

export interface Props {
  title?: string
  description?: string
}

const { title = 'SMK Negeri 1 Tabanan - Sekolah Menengah Kejuruan Terakreditasi A', description = 'SMK Negeri 1 Tabanan - Sekolah kejuruan unggulan dengan program keahlian Akuntansi, Pemasaran, Administrasi Perkantoran, dan Teknik Komputer Jaringan' } = Astro.props
const programs = (await getCollection('programs')).map(e => e.data)
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href={base + 'favicon.png'}>
  <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header id="header" class="fixed w-full z-50 transition-all duration-300 bg-primary-900/85 backdrop-blur-md">
    <div class="container">
      <nav class="flex items-center justify-between h-20">
        <a href={base} class="flex items-center gap-3">
          <img src={base + 'assets/logo.png'} alt="SMK Negeri 1 Tabanan" class="h-12 w-auto">
          <div class="hidden sm:block">
            <span class="text-white font-bold text-sm leading-tight block">SMK Negeri 1 Tabanan</span>
          </div>
        </a>
        <ul class="hidden lg:flex items-center gap-1">
          <li class="nav-item"><a href={base + '#beranda'} class="nav-link">Beranda</a></li>
          <li class="nav-item dropdown">
            <a href={base + '#profil'} class="nav-link dropdown-toggle">Profil</a>
            <ul class="dropdown-menu">
              <li><a href={base + '#profil'} class="dropdown-link">Visi & Misi</a></li>
              <li><a href={base + 'sejarah'} class="dropdown-link">Sejarah</a></li>
              <li><a href={base + 'fasilitas'} class="dropdown-link">Fasilitas</a></li>
              <li><a href={base + 'prestasi'} class="dropdown-link">Prestasi</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a href={base + '#program'} class="nav-link dropdown-toggle">Program</a>
            <ul class="dropdown-menu">
              {programs.map((p: any) => <li><a href={base + 'detail/' + p.id} class="dropdown-link">{p.singkat}</a></li>)}
            </ul>
          </li>
          <li class="nav-item"><a href={base + '#berita'} class="nav-link">Berita</a></li>
          <li class="nav-item"><a href={base + '#kontak'} class="nav-link">Kontak</a></li>
          <li class="nav-item"><a href="https://bali.spmb.id" class="btn btn-accent text-sm px-4 py-2 ml-2" target="_blank">PPDB Online</a></li>
        </ul>
        <button id="menu-toggle" class="lg:hidden menu-button" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </div>
  </header>

  <div id="mobile-menu" class="fixed inset-0 bg-primary-900/95 z-40 translate-x-full lg:hidden">
    <div class="flex flex-col items-center justify-center h-full">
      <button id="menu-close" class="absolute top-6 right-6 text-white text-3xl">&times;</button>
      <div class="mobile-nav">
        <a href={base + '#beranda'} class="mobile-nav-link" data-section>Beranda</a>
        <div class="mobile-nav-group">
          <button class="mobile-nav-toggle">Profil</button>
          <div class="mobile-nav-sub">
            <a href={base + '#profil'} class="mobile-nav-link" data-section>Visi & Misi</a>
            <a href={base + 'sejarah'} class="mobile-nav-link">Sejarah</a>
            <a href={base + 'fasilitas'} class="mobile-nav-link">Fasilitas</a>
            <a href={base + 'prestasi'} class="mobile-nav-link">Prestasi</a>
          </div>
        </div>
        <div class="mobile-nav-group">
          <button class="mobile-nav-toggle">Program</button>
          <div class="mobile-nav-sub">
            {programs.map((p: any) => <a href={base + 'detail/' + p.id} class="mobile-nav-link">{p.singkat}</a>)}
          </div>
        </div>
        <a href={base + '#berita'} class="mobile-nav-link" data-section>Berita</a>
        <a href={base + '#kontak'} class="mobile-nav-link" data-section>Kontak</a>
        <a href="https://bali.spmb.id" class="btn btn-accent mt-6" target="_blank">PPDB Online</a>
      </div>
    </div>
  </div>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-logo mb-4">
            <img src={base + 'assets/logo.png'} alt="SMK Negeri 1 Tabanan" class="h-16 w-auto">
          </div>
          <p class="text-neutral-400 mb-4 leading-relaxed">SMK Negeri 1 Tabanan adalah sekolah kejuruan unggulan yang telah berdiri sejak tahun 1963.</p>
          <div class="flex space-x-3">
            <a href="#" class="social-icon footer-social-icon" aria-label="Instagram"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
            <a href="#" class="social-icon footer-social-icon" aria-label="YouTube"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
          </div>
        </div>
        <div>
          <h3 class="footer-heading">Tentang</h3>
          <ul class="space-y-2">
            <li><a href={base + '#profil'} class="footer-link">Profil Sekolah</a></li>
            <li><a href={base + 'sejarah'} class="footer-link">Sejarah</a></li>
            <li><a href={base + 'fasilitas'} class="footer-link">Fasilitas</a></li>
            <li><a href={base + 'prestasi'} class="footer-link">Prestasi</a></li>
          </ul>
        </div>
        <div>
          <h3 class="footer-heading">Program</h3>
          <ul class="space-y-2">
            {programs.map((p: any) => <li><a href={base + 'detail/' + p.id} class="footer-link">{p.nama}</a></li>)}
            <li class="pt-2"><a href={base + '#galeri'} class="footer-link text-sm text-neutral-500">Galeri Foto</a></li>
          </ul>
        </div>
        <div>
          <h3 class="footer-heading">Kontak</h3>
          <ul class="space-y-3">
            <li><p class="text-neutral-400 text-sm leading-relaxed">Jl. Diponegoro No.9, Delod Peken, Kec. Tabanan, Kabupaten Tabanan, Bali 82121</p></li>
            <li><a href="tel:0361811012" class="footer-link">(0361) 811012</a></li>
            <li><a href="mailto:info@smkn1tabanan.sch.id" class="footer-link">info@smkn1tabanan.sch.id</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} SMK Negeri 1 Tabanan.</p>
        <div class="flex space-x-4">
          <a href={base + '#berita'} class="footer-link text-sm">Berita</a>
          <a href={base + '#kontak'} class="footer-link text-sm">Hubungi Kami</a>
        </div>
      </div>
    </div>
  </footer>

  <button id="back-to-top" class="back-to-top-button hidden" aria-label="Kembali ke atas">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
  </button>

  <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script>
    AOS.init({ duration: 800, once: true })

    const menuToggle = document.getElementById('menu-toggle'), menuClose = document.getElementById('menu-close')
    const mobileMenu = document.getElementById('mobile-menu')
    const closeMenu = () => { mobileMenu?.classList.add('translate-x-full'); menuToggle?.classList.remove('open'); document.body.style.overflow = '' }
    menuToggle?.addEventListener('click', () => { mobileMenu?.classList.remove('translate-x-full'); menuToggle.classList.add('open'); document.body.style.overflow = 'hidden' })
    menuClose?.addEventListener('click', closeMenu)
    document.querySelectorAll('[data-section]').forEach(l => l.addEventListener('click', closeMenu))

    document.querySelectorAll('.mobile-nav-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('open')
        const sub = btn.nextElementSibling
        if (sub) sub.classList.toggle('open')
      })
    })

    const backBtn = document.getElementById('back-to-top')
    window.addEventListener('scroll', () => { backBtn?.classList.toggle('hidden', window.scrollY <= 300); backBtn?.classList.toggle('visible', window.scrollY > 300) })
    backBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))

    const navLinks = document.querySelectorAll('.nav-link:not(.dropdown-toggle)')
    const sections = document.querySelectorAll('section[id]')
    const basePath = document.querySelector('link[rel="icon"]')?.getAttribute('href')?.replace(/favicon\.png$/, '') || '/'
    window.addEventListener('scroll', () => {
      let current = ''
      sections.forEach(s => { const top = s.offsetTop - 200; if (window.scrollY >= top) current = s.getAttribute('id') || '' })
      navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === basePath + '#' + current))
    })
  </script>
</body>
</html>
